{
  "entities": {
    "Barber": {
      "title": "Barber",
      "description": "Barbershop staff member",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "maxLength": 100 },
        "photo": { "type": "string", "maxLength": 500 },
        "specialties": { "type": "array" },
        "description": { "type": "string", "maxLength": 500 },
        "rating": { "type": "number" },
        "reviewsCount": { "type": "number" },
        "status": { "type": "string", "enum": ["available", "busy", "off"] }
      },
      "required": ["name", "role", "photo", "rating", "status"]
    },
    "ServiceItem": {
      "title": "ServiceItem",
      "description": "Individual service or combo offering",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "price": { "type": "number" },
        "durationMinutes": { "type": "number" },
        "description": { "type": "string", "maxLength": 500 },
        "category": { "type": "string", "enum": ["individual", "combo"] },
        "popular": { "type": "boolean" }
      },
      "required": ["name", "price", "durationMinutes", "category"]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "Customer booking appointment",
      "type": "object",
      "properties": {
        "customerId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 100 },
        "customerPhone": { "type": "string", "maxLength": 30 },
        "barberId": { "type": "string", "maxLength": 100 },
        "barberName": { "type": "string", "maxLength": 100 },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "startTime": { "type": "string", "pattern": "^\\d{2}:\\d{2}$" },
        "endTime": { "type": "string", "pattern": "^\\d{2}:\\d{2}$" },
        "services": { "type": "array" },
        "isCombo": { "type": "boolean" },
        "totalDuration": { "type": "number" },
        "totalPrice": { "type": "number" },
        "status": { "type": "string", "enum": ["Agendado", "Confirmado", "Concluído", "Cancelado"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "cancelledAt": { "type": "string" }
      },
      "required": ["barberId", "date", "startTime", "endTime", "services", "totalDuration", "totalPrice", "status", "createdAt"]
    },
    "FeedPost": {
      "title": "FeedPost",
      "description": "News and promotion post",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "maxLength": 50 },
        "content": { "type": "string", "maxLength": 2000 },
        "image": { "type": "string", "maxLength": 500 },
        "date": { "type": "string", "maxLength": 50 },
        "likesCount": { "type": "number" },
        "author": { "type": "string", "maxLength": 100 }
      },
      "required": ["title", "category", "content", "date", "likesCount", "author"]
    },
    "DeletedAppointmentRecord": {
      "title": "DeletedAppointmentRecord",
      "description": "Log of deleted and archived appointments",
      "type": "object",
      "properties": {
        "originalAppointmentId": { "type": "string", "maxLength": 100 },
        "deletedAt": { "type": "string" },
        "deletedBy": { "type": "string", "enum": ["admin", "cliente"] },
        "deletedByName": { "type": "string", "maxLength": 100 },
        "reason": { "type": "string", "maxLength": 500 }
      },
      "required": ["originalAppointmentId", "deletedAt", "deletedBy"]
    },
    "PasswordResetRequest": {
      "title": "PasswordResetRequest",
      "description": "Client password reset request and 6-digit temp code",
      "type": "object",
      "properties": {
        "customerName": { "type": "string", "maxLength": 100 },
        "customerPhone": { "type": "string", "maxLength": 50 },
        "customerEmail": { "type": "string", "maxLength": 100 },
        "tempCode": { "type": "string", "maxLength": 10 },
        "status": { "type": "string", "enum": ["pendente", "temp_code_generated", "concluido", "cancelado"] },
        "createdAt": { "type": "string" }
      },
      "required": ["customerName", "status", "createdAt"]
    }
  },
  "firestore": {
    "/barbers/{barberId}": {
      "schema": { "$ref": "#/entities/Barber" },
      "description": "Barbers collection"
    },
    "/services/{serviceId}": {
      "schema": { "$ref": "#/entities/ServiceItem" },
      "description": "Services and combos collection"
    },
    "/appointments/{appointmentId}": {
      "schema": { "$ref": "#/entities/Appointment" },
      "description": "Customer appointments collection"
    },
    "/feed/{postId}": {
      "schema": { "$ref": "#/entities/FeedPost" },
      "description": "Barbershop feed posts"
    },
    "/deletedAppointments/{delId}": {
      "schema": { "$ref": "#/entities/DeletedAppointmentRecord" },
      "description": "Deleted and archived appointments audit log"
    },
    "/passwordResetRequests/{reqId}": {
      "schema": { "$ref": "#/entities/PasswordResetRequest" },
      "description": "Customer password reset requests"
    }
  }
}
